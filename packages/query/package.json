{
  "name": "@pracht/query",
  "version": "0.0.0",
  "description": "TanStack Query for Pracht: a per-request QueryClient on the server, server-fetched queries hydrated into the browser cache on first load and on every client navigation, and query invalidation after capability mutations.",
  "keywords": [
    "pracht",
    "preact",
    "tanstack-query",
    "react-query",
    "ssr",
    "hydration",
    "data-fetching"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JoviDeCroock/pracht/tree/main/packages/query",
  "bugs": {
    "url": "https://github.com/JoviDeCroock/pracht/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoviDeCroock/pracht",
    "directory": "packages/query"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./preact": {
      "types": "./dist/preact.d.mts",
      "default": "./dist/preact.mjs"
    },
    "./solid": {
      "types": "./dist/solid.d.mts",
      "default": "./dist/solid.mjs"
    },
    "./root": {
      "types": "./dist/root.d.mts",
      "default": "./dist/root.mjs"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@pracht/capabilities": "workspace:*",
    "@pracht/core": "workspace:*"
  },
  "peerDependencies": {
    "@solidjs/h": "2.0.0-rc.14",
    "@tanstack/preact-query": "^5.91.0",
    "@tanstack/solid-query": "^5.91.0",
    "preact": "^10.0.0",
    "solid-js": "2.0.0-rc.14"
  },
  "peerDependenciesMeta": {
    "@solidjs/h": {
      "optional": true
    },
    "@tanstack/preact-query": {
      "optional": true
    },
    "@tanstack/solid-query": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/h": "2.0.0-rc.14",
    "@tanstack/preact-query": "^5.91.0",
    "@tanstack/solid-query": "^5.91.0",
    "preact": "11.0.0-rc.1",
    "preact-render-to-string": "^6.7.0",
    "solid-js": "2.0.0-rc.14"
  }
}

