{
  "name": "@pracht/preact",
  "version": "0.1.0",
  "description": "Preact UI renderer for Pracht: Vite plugins, SSR, hydration, hooks, and islands.",
  "keywords": [
    "pracht",
    "preact",
    "renderer",
    "ssr",
    "vite"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JoviDeCroock/pracht/tree/main/packages/preact",
  "bugs": {
    "url": "https://github.com/JoviDeCroock/pracht/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoviDeCroock/pracht",
    "directory": "packages/preact"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.mts",
      "default": "./dist/hooks.mjs"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@pracht/core": "workspace:*",
    "@pracht/preact-ssr-precompile": "workspace:*",
    "@preact/preset-vite": "^2.10.5",
    "@prefresh/vite": "^2.0.0"
  },
  "peerDependencies": {
    "preact": "^10.0.0 || ^11.0.0-0",
    "preact-render-to-string": "^6.7.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "preact": "11.0.0-rc.1",
    "preact-render-to-string": "^6.7.0",
    "vite": "^8.0.0"
  }
}
